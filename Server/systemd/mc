#!/usr/bin/env bash
# =============================================================================
# /usr/local/bin/mc
# -----------------------------------------------------------------------------
# UTILITÁRIO DE OPERAÇÃO DO SERVIDOR MINECRAFT BEDROCK "NEVER LAND"
#
# Reúne em um só comando as operações do dia a dia pelo SSH, para não ser
# preciso decorar comandos do systemd, do journal ou caminhos de arquivos.
#
# Uso:  mc <ação> [argumentos]
#       mc ajuda          -> lista todas as ações
#
# Exemplos:
#   mc status                 # está rodando? quanto de RAM usa?
#   mc cmd "list"             # quem está online
#   mc say "Reinício em 5 min" # mensagem no chat do jogo
#   mc logs                   # log ao vivo (Ctrl+C para sair)
#   mc backup                 # backup manual imediato
# =============================================================================

# Para o script em erros de variáveis não definidas e falhas em pipes
set -uo pipefail

# ----------------------------------------------------------------------------
# Configurações (caminhos padrão da instalação)
# ----------------------------------------------------------------------------
SERVICE="bedrock.service"                    # unidade systemd do servidor
FIFO="/run/bedrock.console"                  # console do servidor (bedrock.socket)
BASE="/home/opc/minecraft"                   # pasta raiz do projeto
SERVER_DIR="$BASE/server"                    # pasta do bedrock_server
BACKUP_DIR="$BASE/backups"                   # pasta dos backups .tar.gz

# ----------------------------------------------------------------------------
# Cores para deixar a saída mais legível no terminal
# ----------------------------------------------------------------------------
VERDE="\033[1;32m"; VERMELHO="\033[1;31m"; AMARELO="\033[1;33m"; AZUL="\033[1;36m"; FIM="\033[0m"

# ----------------------------------------------------------------------------
# enviar_comando: escreve um comando no console do servidor e mostra a
# resposta que o servidor imprimir no journal logo em seguida.
#   $1 = comando de console (ex.: "list", "say Olá", "kick Fulano")
# ----------------------------------------------------------------------------
enviar_comando() {
    local comando="$1"

    # O servidor precisa estar rodando para existir o FIFO do console
    if ! systemctl is-active --quiet "$SERVICE" || [ ! -p "$FIFO" ]; then
        echo -e "${VERMELHO}[ERRO]${FIM} Servidor parado. Inicie com: mc start"
        return 1
    fi

    # Marca a posição atual do journal ("cursor") para exibir só as linhas novas
    local cursor
    cursor=$(sudo journalctl -u "$SERVICE" -n 0 --show-cursor -q 2>/dev/null | sed -n 's/^-- cursor: //p')

    # Envia o comando ao console (equivale a digitar no terminal do servidor)
    echo "$comando" > "$FIFO"
    echo -e "${AZUL}>>${FIM} $comando"

    # Dá um instante para o servidor processar e escrever a resposta
    sleep 1.5

    # Mostra somente o que o servidor escreveu depois do comando
    if [ -n "$cursor" ]; then
        sudo journalctl -u "$SERVICE" --after-cursor="$cursor" --no-pager -o cat
    else
        sudo journalctl -u "$SERVICE" -n 10 --no-pager -o cat
    fi
}

# ----------------------------------------------------------------------------
# mostrar_ajuda: lista de todas as ações disponíveis
# ----------------------------------------------------------------------------
mostrar_ajuda() {
    cat <<'EOF'
==================== mc - Operação do servidor Never Land ====================

 SERVIÇO
   mc status            Estado do servidor, RAM, uptime e jogadores online
   mc start             Liga o servidor
   mc stop              Desliga o servidor (salva o mundo antes)
   mc restart           Reinicia o servidor (avisa os jogadores 10 s antes)
   mc boot              Confere se o servidor está configurado p/ subir no boot

 CONSOLE DO JOGO
   mc cmd "<comando>"   Envia qualquer comando de console. Ex: mc cmd "list"
   mc list              Jogadores online
   mc say "<texto>"     Mensagem no chat para todos os jogadores
   mc kick <jogador>    Expulsa um jogador

 LOGS
   mc logs              Log ao vivo (Ctrl+C para sair)
   mc log [N]           Últimas N linhas do log (padrão 50)
   mc jogadores         Histórico de conexões/desconexões (mostra XUIDs)

 BACKUP
   mc backup            Backup manual imediato
   mc backups           Lista os backups existentes

 MANUTENÇÃO
   mc update            Atualiza o BDS para a última versão (preserva o mundo)
   mc recursos          RAM, swap, disco e carga de CPU
   mc rede              Portas abertas no firewall e portas em escuta
   mc config            Mostra o server.properties (sem comentários)
==============================================================================
EOF
}

# ----------------------------------------------------------------------------
# Roteamento da ação escolhida (primeiro argumento)
# ----------------------------------------------------------------------------
ACAO="${1:-ajuda}"
shift || true   # remove a ação da lista de argumentos (se houver)

case "$ACAO" in

    # ---------------------------- SERVIÇO -----------------------------------
    status)
        # Resumo do systemd (ativo?, PID, memória, há quanto tempo)
        systemctl status "$SERVICE" --no-pager -n 0
        echo
        # Se estiver rodando, pergunta ao servidor quem está online
        systemctl is-active --quiet "$SERVICE" && enviar_comando "list"
        ;;

    start)
        sudo systemctl start "$SERVICE" && echo -e "${VERDE}[OK]${FIM} Servidor iniciado. Acompanhe com: mc logs"
        ;;

    stop)
        echo -e "${AMARELO}[...]${FIM} Desligando e salvando o mundo..."
        sudo systemctl stop "$SERVICE" && echo -e "${VERDE}[OK]${FIM} Servidor desligado."
        ;;

    restart)
        # Avisa os jogadores antes de derrubar a conexão
        if systemctl is-active --quiet "$SERVICE"; then
            enviar_comando "say §eO servidor vai reiniciar em 10 segundos!" >/dev/null
            echo -e "${AMARELO}[...]${FIM} Jogadores avisados. Reiniciando em 10 s..."
            sleep 10
        fi
        sudo systemctl restart "$SERVICE" && echo -e "${VERDE}[OK]${FIM} Servidor reiniciado."
        ;;

    boot)
        # Mostra tudo que garante a subida automática após um reboot
        echo -e "Auto-start no boot ........ $(systemctl is-enabled "$SERVICE")   (esperado: enabled)"
        echo -e "Espera de rede no boot .... $(systemctl is-enabled NetworkManager-wait-online.service)   (esperado: enabled)"
        echo -e "Firewall no boot .......... $(systemctl is-enabled firewalld)   (esperado: enabled)"
        echo -e "Swap no /etc/fstab ........ $(grep -q '^/swapfile' /etc/fstab && echo sim || echo NAO)   (esperado: sim)"
        echo -e "Serviço agora ............. $(systemctl is-active "$SERVICE")"
        echo -e "Último boot da VM ......... $(uptime -s)"
        ;;

    # ---------------------------- CONSOLE -----------------------------------
    cmd)
        [ $# -eq 0 ] && { echo 'Uso: mc cmd "<comando>"'; exit 1; }
        enviar_comando "$*"
        ;;

    list)
        enviar_comando "list"
        ;;

    say)
        [ $# -eq 0 ] && { echo 'Uso: mc say "<mensagem>"'; exit 1; }
        enviar_comando "say $*"
        ;;

    kick)
        [ $# -eq 0 ] && { echo 'Uso: mc kick <jogador> [motivo]'; exit 1; }
        enviar_comando "kick $*"
        ;;

    # ------------------------------ LOGS ------------------------------------
    logs)
        sudo journalctl -u "$SERVICE" -f -o cat
        ;;

    log)
        sudo journalctl -u "$SERVICE" -n "${1:-50}" --no-pager -o cat
        ;;

    jogadores)
        # Filtra apenas as linhas de entrada/saída de jogadores (com XUID)
        sudo journalctl -u "$SERVICE" --no-pager -o cat | grep -Ei "Player (connected|disconnected|Spawned)" | tail -n 50
        ;;

    # ----------------------------- BACKUP -----------------------------------
    backup)
        "$BASE/backup.sh" && echo -e "${VERDE}[OK]${FIM} Backup concluído:" && ls -lht "$BACKUP_DIR" | head -n 2
        ;;

    backups)
        ls -lht "$BACKUP_DIR"
        ;;

    # --------------------------- MANUTENÇÃO ---------------------------------
    update)
        "$BASE/install_or_update.sh" && sudo systemctl restart "$SERVICE" && echo -e "${VERDE}[OK]${FIM} Atualizado e reiniciado."
        ;;

    recursos)
        free -h; echo; df -h /; echo; uptime
        echo; systemctl show "$SERVICE" -p MemoryCurrent -p MemoryHigh -p MemoryMax -p NRestarts
        ;;

    rede)
        echo "Portas liberadas no firewalld: $(sudo firewall-cmd --list-ports)"
        echo; sudo ss -ulpn | grep -E "1913[23]" ; sudo ss -tlpn | grep 19132
        ;;

    config)
        grep -Ev '^\s*(#|$)' "$SERVER_DIR/server.properties"
        ;;

    ajuda|help|-h|--help)
        mostrar_ajuda
        ;;

    *)
        echo -e "${VERMELHO}Ação desconhecida:${FIM} $ACAO"; echo
        mostrar_ajuda
        exit 1
        ;;
esac

